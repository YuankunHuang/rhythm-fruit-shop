        { "speaker": "焰子", "text": "在这儿喝。", "expr": "neutral" },
        { "speaker": "你", "text": "那边有凳子。" },
        { "speaker": "焰子", "text": "不坐。坐下去就起不来了。", "expr": "neutral" },
        { "speaker": "", "text": "她靠着吧台站着，手机搁在台面上，屏幕朝上，倒计时还开着。" },
        { "speaker": "柚子", "text": "跑了一天？", "expr": "neutral" },
        { "speaker": "焰子", "text": "早上七点出的门。", "expr": "neutral" },
        { "speaker": "焰子", "text": "今天跑得顺。再给我一个钟头，能多跑三单。", "expr": "grin" },
        { "speaker": "柚子", "text": "它不给。", "expr": "deadpan" },
        { "speaker": "焰子", "text": "它不给。", "expr": "neutral" },
