      "variable": "customer",
      "byDrink": {
        "lemon_water": [
          { "speaker": "", "text": "他插上吸管，捏着杯子转了一圈。" },
          { "speaker": "阿晟", "text": "没有阻力。", "expr": "neutral" },
          { "speaker": "阿晟", "text": "……也行。", "expr": "focused" },
          { "speaker": "阿晟", "text": "几块？", "expr": "neutral" },
          { "speaker": "你", "text": "六块。" },
          { "speaker": "", "text": "他数出六枚硬币，在台面上排成一行，食指点了一遍，推过来。" }
        ],
        "fruit_cup": [
          { "speaker": "", "text": "他低头看那杯鲜果杯。七样水果，一层一层码着。" },
          { "speaker": "阿晟", "text": "分轨的。", "expr": "focused" },
          { "speaker": "你", "text": "什么？" },
          { "speaker": "阿晟", "text": "每一层分开放，没混。", "expr": "neutral" },
          { "speaker": "", "text": "他叉起一块菠萝，嚼了很久。" },
          { "speaker": "阿晟", "text": "十五？", "expr": "neutral" },
          { "speaker": "你", "text": "十五。" },
          { "speaker": "", "text": "他放下一张十块、一张五块，边对齐了，才推过来。" }
        ]
      },
      "branches": [
        {
          "min": 88,
          "label": "好评 (>=88)",
          "nodes": [
            { "speaker": "阿晟", "text": "参数对了。", "expr": "focused" },
            { "speaker": "", "text": "吸管插进去的时候，他停了半秒。" },
            { "speaker": "阿晟", "text": "再打一杯。一样的，带走。", "expr": "neutral" },
            { "speaker": "", "text": "他付了两杯的钱，把找零在台面上摆成一行，大的在左，小的在右。食指从左到右点了一遍，才收进口袋。" }
          ]
        },
        {
          "min": 62,
          "label": "一般 (>=62)",
          "nodes": [
            { "speaker": "阿晟", "text": "差一点。", "expr": "neutral" },
            { "speaker": "", "text": "他用手在空中比了一个高度。" },
            { "speaker": "阿晟", "text": "稠度应该在这儿。", "expr": "focused" },
            { "speaker": "你", "text": "这儿是多少？" },
            { "speaker": "阿晟", "text": "感觉上的这儿。不是物理上的。", "expr": "neutral" },
            { "speaker": "", "text": "（「感觉」。说实话有点抽象。）" },
            { "speaker": "阿晟", "text": "下次再来。", "expr": "neutral" }
          ]
        },
        {
          "min": 0,
          "label": "较差",
          "nodes": [
            { "speaker": "阿晟", "text": "冰多了。", "expr": "neutral" },
            { "speaker": "你", "text": "……多了多少？" },
            { "speaker": "阿晟", "text": "零点八个标准差以上。", "expr": "focused" },
            { "speaker": "", "text": "（他是认真的。我也认真想了一下：样本量只有一杯。）" },
            { "speaker": "你", "text": "我重做一杯？" },
            { "speaker": "阿晟", "text": "不用。误差在接受范围内。", "expr": "neutral" }
          ]
        }
      ],
      "after": [
        { "speaker": "", "text": "他没走，靠着吧台站着。手机还扣在台面上。" }
      ]
