          { "speaker": "", "text": "他看了一眼台面上摆开的七样，没再说什么，站着等。" }
        ],
        "_default": [
          { "speaker": "阿晟", "text": "……不是这个。", "expr": "neutral" }
        ]
      }
    },
    {
      "id": "after_ashen",
