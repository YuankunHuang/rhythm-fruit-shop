          { "speaker": "", "text": "你拿起一颗柠檬，刀已经下去了。" },
          { "speaker": "阿晟", "text": "……柠檬水？", "expr": "neutral" },
          { "speaker": "阿晟", "text": "我说的是冰沙。", "expr": "neutral" },
          { "speaker": "阿晟", "text": "算了。别停，接着走完。", "expr": "focused" }
        ],
        "fruit_cup": [
          { "speaker": "", "text": "你从冷柜里端出草莓、橙子、菠萝，一样一样摆开。" },
          { "speaker": "阿晟", "text": "彩虹鲜果杯。", "expr": "neutral" },
