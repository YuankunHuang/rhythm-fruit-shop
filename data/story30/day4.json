        { "speaker": "林小末", "text": "……你写字好慢。", "expr": "neutral" },
        { "speaker": "你", "text": "嗯。" },
        { "speaker": "林小末", "text": "（很小声）慢点好。跟得上。", "expr": "awkward" }
      ]
