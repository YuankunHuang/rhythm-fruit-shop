{
  "id": "day5",
  "title": "第5天",
  "slots": ["day", "dusk", "night"],
  "menuIds": ["fruitCup", "citrusFizz"],
  "phases": [
    {
      "id": "morning",
      "type": "dialogue",
      "ticker": ["绿芯科技发布机器人专用微型预训练模型，称“小到能装进一只鞋盒”", "昨夜暴雨，全城外卖骑手集体离线约两小时，今晨陆续上线；平台回应“已优化恶劣天气派单策略”", "本市试行“情感陪伴机器人进社区”，首批一千台将送往独居老人家中", "气象台：今天阴转晴"],
      "nodes": [
        { "speaker": "", "text": "第五天。夜里下过雨，门口的地砖还是湿的。" },
        { "speaker": "", "text": "广告牌又歪了。短腿底下那块小石头，被雨水冲到了马路牙子边上。" },
        { "speaker": "", "text": "你找了块差不多大的，塞回去，按了按。" },
        { "speaker": "", "text": "（方叔那块比较圆。）" },
        { "speaker": "", "text": "你拉起卷帘门，开灯，把门口的脚垫翻过来晾着。冷柜在角落里嗡嗡地响，不用敲。" },
        { "speaker": "", "text": "七点五十，柚子到了，手里拎着一袋包子。" },
        { "speaker": "柚子", "text": "吃了没？", "expr": "neutral" },
        { "speaker": "你", "text": "没。" },
        { "speaker": "", "text": "她把袋子往吧台上一放，自己拿了一个，剩下两个推到你面前。" },
        { "speaker": "柚子", "text": "昨晚那场雨，我阳台上晾的衣服全白洗了。", "expr": "deadpan" },
        { "speaker": "你", "text": "没收？" },
        { "speaker": "柚子", "text": "听见了。不想起。", "expr": "deadpan" },
        { "speaker": "", "text": "她叼着包子，掏出手机，用一根手指在屏幕上戳数字。戳一下，翻一页账本，再戳一下。" },
        { "speaker": "", "text": "屏幕上是你做的那张表格。" },
        { "speaker": "你", "text": "昨天的数？" },
        { "speaker": "柚子", "text": "填着呢。别站我后面。", "expr": "neutral" },
        { "speaker": "", "text": "表格最右边多了一列，表头两个字：心情。一格一个小表情，太阳、太阳、云、太阳。" },
        { "speaker": "你", "text": "这列我没做。" },
        { "speaker": "柚子", "text": "我自己加的。", "expr": "deadpan" },
        { "speaker": "你", "text": "它不参与计算。" },
        { "speaker": "柚子", "text": "谁让它参与了。", "expr": "deadpan" },
        { "speaker": "你", "text": "利润往下走那几天，填的都是太阳。" },
        { "speaker": "柚子", "text": "那几天天气好。", "expr": "smile" },
        { "speaker": "", "text": "她锁了屏，手机揣回围裙兜里。" },
        { "speaker": "", "text": "七点五十五，收音机自己响了。新闻说，昨晚大雨，全城的外卖骑手集体离线了两个小时；今天早上，又都上线了。" },
        { "speaker": "柚子", "text": "两个小时。", "expr": "deadpan" },
        { "speaker": "", "text": "她去后厨端了一筐柠檬出来，倒在案板上。" },
        { "speaker": "你", "text": "我想了一件事。" },
        { "speaker": "柚子", "text": "又想。", "expr": "deadpan" },
        { "speaker": "你", "text": "扫码点单。门口贴个码，客人自己选、自己付，我们只管做。高峰的时候能省一个人。" },
        { "speaker": "柚子", "text": "省谁？", "expr": "deadpan" },
        { "speaker": "你", "text": "不是省人，是省排队的时间——" },
        { "speaker": "柚子", "text": "店里就两个人。省你，还是省我？", "expr": "deadpan" },
        { "speaker": "", "text": "她把柠檬一个一个摆开，摆到一半，清了清嗓子。" },
        { "speaker": "柚子", "text": "好。我们来想象一下。", "expr": "smile" },
        { "speaker": "柚子", "text": "一位客人，风尘仆仆，推门而入。他口干舌燥，他心事重重，他只想说一句：「来杯冰的。」", "expr": "teasing" },
        { "speaker": "柚子", "text": "可迎接他的，是墙上一块黑白方块。", "expr": "teasing" },
        { "speaker": "柚子", "text": "他低头，抬手，「嘀」。从此，这杯柠檬水是谁做的，他不知道；他是谁，这杯柠檬水也不知道。", "expr": "serious" },
        { "speaker": "柚子", "text": "少年，你管这叫省时间。我管这叫——", "expr": "smile" },
        { "speaker": "你", "text": "叫什么？" },
        { "speaker": "柚子", "text": "……还没想好。反正不行。", "expr": "deadpan" },
        { "speaker": "你", "text": "高峰的时候真的能——" },
        { "speaker": "柚子", "text": "你是来打工的，还是来改造我们的？", "expr": "annoyed" },
        { "speaker": "你", "text": "……打工的。" },
        { "speaker": "柚子", "text": "那就打工。三十个，切片，跟昨天一样厚。", "expr": "neutral" },
        { "speaker": "你", "text": "好。" },
        { "speaker": "柚子", "text": "我去趟批发市场，葡萄。中午前回来。", "expr": "neutral" },
        { "speaker": "", "text": "她解下围裙搭在椅背上，拿上钥匙走了。风铃响了一下。" },
        { "speaker": "", "text": "你切到第七个柠檬，才想起包子还没吃。" }
      ]
    },
    {
      "id": "visit_guiwei",
      "type": "dialogue",
      "nodes": [
        { "speaker": "", "text": "十点多，进来一个女生。帆布包，头发随手一抓。手上有颜料，洗过了洗不掉的那种：指甲缝里一点蓝，虎口上一点赭石。" },
        { "speaker": "", "text": "她在门口站着，先把店里看了一圈。墙，灯，冷柜，菜单板，最后才看你。" },
        { "speaker": "顾薇", "text": "门口那块牌子，红漆是后补的。", "expr": "neutral" },
        { "speaker": "你", "text": "是吗？" },
        { "speaker": "顾薇", "text": "两种红。", "expr": "neutral" },
        { "speaker": "", "text": "（我扶了它两回，没看出来。）" },
        { "speaker": "你", "text": "喝点什么？" },
        { "speaker": "顾薇", "text": "葡萄冰沙。要看得见颗粒。", "expr": "neutral" },
        { "speaker": "你", "text": "冰量呢？堂食还是打包？" },
        { "speaker": "顾薇", "text": "坐。冰正常。", "expr": "neutral" },
        { "speaker": "你", "text": "颗粒要多大？" },
        { "speaker": "", "text": "她伸出手，拇指和食指捏出一道缝。" },
        { "speaker": "顾薇", "text": "绿豆。", "expr": "neutral" },
        { "speaker": "你", "text": "绿豆大。好。" },
        { "speaker": "", "text": "她在靠窗的位置坐下，从包里拿出一个旧手绘本，边角磨得发软。翻开，拿铅笔画吧台上那排倒扣的杯子。几根线，杯子就立住了。" },
        { "speaker": "", "text": "包里的平板震了两下。她看了一眼，把手绘本推到一边，换成平板。" },
        { "speaker": "", "text": "屏幕上是一间客厅，沙发，绿植，落地窗，干净得发亮。她拿笔沿着沙发描了一道边，描完，在线尾抖了一下。" },
        { "speaker": "你", "text": "这是……修图？" },
        { "speaker": "顾薇", "text": "加笔触。", "expr": "neutral" },
        { "speaker": "顾薇", "text": "AI 出的图。客户要「人味儿」。", "expr": "lost_in_thought" },
        { "speaker": "你", "text": "人味儿怎么加？" },
        { "speaker": "顾薇", "text": "边线抖一点。颜色出一点格。", "expr": "neutral" },
        { "speaker": "顾薇", "text": "阴影里掺点灰紫。", "expr": "neutral" },
        { "speaker": "", "text": "她又抖了一笔，放大看了看，撤销了。" },
        { "speaker": "顾薇", "text": "抖多了。", "expr": "neutral" },
        { "speaker": "你", "text": "多了会怎么样？" },
        { "speaker": "顾薇", "text": "假。", "expr": "neutral" },
        { "speaker": "", "text": "平板又震了一下。她回了一个字，把平板扣在桌上。" },
        { "speaker": "你", "text": "你是画画的？" },
        { "speaker": "顾薇", "text": "嗯。", "expr": "neutral" },
        { "speaker": "你", "text": "以前也画这个？" },
        { "speaker": "顾薇", "text": "以前画书。封面，插图。", "expr": "neutral" },
        { "speaker": "", "text": "她把手绘本拉回来，翻到靠后的一页，转过来推给你。" },
        { "speaker": "顾薇", "text": "这张。哪儿不对？", "expr": "neutral" },
        { "speaker": "", "text": "一张很小的画。一个靠窗的座位，窗外是傍晚，座位上没有人。" },
        { "speaker": "", "text": "你看了一会儿。" },
        { "speaker": "你", "text": "左边那块，比右边暗。" },
        { "speaker": "顾薇", "text": "……对。", "expr": "neutral" },
        { "speaker": "", "text": "她从笔袋里摸出一截很短的白色彩铅，在那块颜色上轻轻压了一层，拿远了看。" },
        { "speaker": "顾薇", "text": "比客户强。", "expr": "rare_smile" },
        { "speaker": "你", "text": "客户说什么？" },
        { "speaker": "顾薇", "text": "「再高级一点」。三版了。", "expr": "neutral" },
        { "speaker": "", "text": "她合上本子，手按在封面上。" },
        { "speaker": "", "text": "（要看得见颗粒，就不能一直按着打到底。）" },
        { "speaker": "", "text": "（打到一半松手，剩下的，用刀。）" },
        { "speaker": "", "text": "（柚子还没回来。）" },
        { "speaker": "订单", "html": "<div class=\"order-card\"><span>葡萄冰沙</span><b>顾薇</b><span>要看得见颗粒 · 绿豆大 · 左边暗了</span></div>" }
      ]
    },
    { "id": "service_guiwei", "type": "service", "unlockInput": "chop", "songId": "grape_smoothie_smolder", "menuId": "grapeSmoothie", "slotId": "day" },
    {
      "id": "after_guiwei",
      "type": "score_branch",
      "variable": "customer",
      "branches": [
        {
          "style": "chop",
          "minShare": 0.3,
          "label": "切出来的",
          "nodes": [
            { "speaker": "", "text": "她把吸管戳下去，又抽出来，看吸管上挂着的果粒。" },
            { "speaker": "顾薇", "text": "有阻力。", "expr": "neutral" },
            { "speaker": "", "text": "她把杯子举到窗边，对着光转了半圈。" },
            { "speaker": "顾薇", "text": "打的，每一粒一样大。", "expr": "neutral" },
            { "speaker": "顾薇", "text": "你这个，大的大，小的小。", "expr": "neutral" },
            { "speaker": "你", "text": "切的。" },
            { "speaker": "顾薇", "text": "嗯。看得出来。", "expr": "rare_smile" }
          ]
        },
        {
          "min": 88,
          "label": "好评 (>=88)",
          "nodes": [
            { "speaker": "", "text": "她喝了一口，没说话，又喝了一口。" },
            { "speaker": "顾薇", "text": "颗粒在。", "expr": "neutral" },
            { "speaker": "顾薇", "text": "行。", "expr": "rare_smile" }
          ]
        },
        {
          "min": 62,
          "label": "一般 (>=62)",
          "nodes": [
            { "speaker": "顾薇", "text": "碎了点。", "expr": "neutral" },
            { "speaker": "", "text": "她用吸管在杯底戳了戳。" },
            { "speaker": "顾薇", "text": "跟水彩多涮了一遍水似的。能喝。", "expr": "neutral" }
          ]
        },
        {
          "min": 0,
          "label": "较差",
          "nodes": [
            { "speaker": "顾薇", "text": "打碎了。", "expr": "neutral" },
            { "speaker": "你", "text": "我重做一杯——" },
            { "speaker": "顾薇", "text": "不用。", "expr": "neutral" },
            { "speaker": "", "text": "她喝了一口，把手绘本又翻开了。" },
            { "speaker": "顾薇", "text": "我今天也废了三张。", "expr": "lost_in_thought" }
          ]
        }
      ],
      "after": [
        { "speaker": "", "text": "她走了。台面上留着一张撕下来的速写。" },
        { "speaker": "", "text": "画的是你，站在案板前面，刀举在半空，嘴抿着。" },
        { "speaker": "", "text": "（原来我切东西是这个表情。）" }
      ]
    },
    {
      "id": "visit_mao2",
      "type": "dialogue",
      "nodes": [
        { "speaker": "", "text": "快中午，门被一部手机推开了。手机先进来，人后进来。" },
        { "speaker": "猫小姐", "text": "家人们，团子妈又来了啊，还是上回那家柠檬水——", "expr": "smile" },
        { "speaker": "", "text": "她举着手机，对着菜单板晃了一圈，按了停止。" },
        { "speaker": "猫小姐", "text": "好了不拍了。你好你好！", "expr": "smile" },
        { "speaker": "你", "text": "团子今天怎么样？" },
        { "speaker": "猫小姐", "text": "它摔了！", "expr": "smile" },
        { "speaker": "你", "text": "……摔了？" },
        { "speaker": "猫小姐", "text": "昨天晚上，它要跳沙发。你知道吧，就是先趴低、屁股扭两下的那种——后腿一蹬空，啪，脸着地。", "expr": "curious" },
        { "speaker": "猫小姐", "text": "然后它自己坐起来舔爪子，假装什么都没发生。我笑死了。我录下来了。不对，是录完才笑死的，录的时候我在憋。", "expr": "smile" },
        { "speaker": "你", "text": "它没事吧？" },
        { "speaker": "猫小姐", "text": "没事！摔完吃了两个罐头，比平时还多一个。", "expr": "smile" },
        { "speaker": "猫小姐", "text": "视频发出去，涨了三百个粉！", "expr": "smile" },
        { "speaker": "", "text": "她把手机翻过来，划到评论区，念给你听。" },
        { "speaker": "猫小姐", "text": "「这才是真猫，AI 团子从来不摔。」还有这条：「终于刷到正版团子了。」", "expr": "curious" },
        { "speaker": "猫小姐", "text": "正版！它当然是正版，它天天睡我枕头上，还打呼。", "expr": "smile" },
        { "speaker": "猫小姐", "text": "……就是得摔一跤，人家才认。", "expr": "neutral" },
        { "speaker": "猫小姐", "text": "不管了！三百个！今天我请团子。", "expr": "smile" },
        { "speaker": "你", "text": "团子又不来。" },
        { "speaker": "猫小姐", "text": "那我替它喝。室温的啊，团子也喝室温的。", "expr": "smile" },
        { "speaker": "订单", "html": "<div class=\"order-card\"><span>柠檬水（室温）</span><b>猫小姐</b><span>团子摔了一跤 · 涨了三百 · 我替它喝</span></div>" }
      ]
    },
    {
      "id": "select_mao2",
      "type": "service_select",
      "customer": "猫小姐",
      "correctId": "lemon_water_light",
      "menuId": "",
      "slotId": "day",
      "allowRetry": true,
      "options": [
        { "songId": "lemon_water_light", "label": "柠檬水（室温）", "hint": "不加冰 · 温和 · 团子同款" },
        { "songId": "lemon_water", "label": "柠檬水（加冰）", "hint": "冰爽 · 清脆" },
        { "songId": "citrus_fizz", "label": "柑橘碳酸", "hint": "有气 · 冲" }
      ],
      "onWrong": {
