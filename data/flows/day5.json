        ],
        "citrus_fizz": [
          { "speaker": "猫小姐", "text": "有气的？", "expr": "curious" },
          { "speaker": "猫小姐", "text": "团子听见「呲」的一声，会钻到床底下去。室温柠檬水，安安静静那种。", "expr": "neutral" }
        ],
        "_default": [
          { "speaker": "猫小姐", "text": "室温柠檬水！团子同款！", "expr": "smile" }
        ]
      }
    },
    {
      "id": "after_mao2",
      "type": "score_branch",
      "variable": "customer",
      "branches": [
        {
          "min": 88,
          "label": "好评 (>=88)",
