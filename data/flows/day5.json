    {
      "id": "after_mao2",
      "type": "score_branch",
      "variable": "customer",
      "branches": [
        {
          "min": 88,
          "label": "好评 (>=88)",
          "nodes": [
            {
              "speaker": "",
              "text": "你端过去，她接过来，用指甲蘸了一点水，在杯盖上划了个猫爪。"
            },
            {
              "speaker": "猫小姐",
              "text": "好看吗。"
            },
            {
              "speaker": "你",
              "text": "还行。"
            },
            {
              "speaker": "猫小姐",
              "text": "（点点头）够用了。"
            }
          ]
        },
        {
          "min": 62,
          "label": "一般 (>=62)",
          "nodes": [
            {
              "speaker": "",
              "text": "她接过来，试了一口，点了点头。"
            },
            {
              "speaker": "猫小姐",
              "text": "差不多。"
            }
          ]
        },
        {
          "min": 0,
          "label": "较差",
          "nodes": [
            {
              "speaker": "猫小姐",
              "text": "有点凉了。"
            },
            {
              "speaker": "你",
              "text": "……抱歉。"
            },
            {
              "speaker": "猫小姐",
              "text": "没事，猫能忍，我也行。"
            }
          ]
        }
      ],
      "after": [
        {
          "speaker": "猫小姐",
          "text": "在考虑要不要换工作。"
        },
        {
          "speaker": "你",
          "text": "什么工作？"
        },
        {
          "speaker": "猫小姐",
          "text": "换一个我能真正上手的地方。"
        },
        {
          "speaker": "",
          "text": "停了一下。"
        },
        {
          "speaker": "你",
          "text": "上手什么。"
        },
        {
          "speaker": "猫小姐",
          "text": "照顾动物。护理，不是前台。"
        },
        {
          "speaker": "",
          "text": "她用手指在杯盖上轻轻划了一下，这次没有划出猫爪印。"
        },
        {
          "speaker": "猫小姐",
          "text": "前台就是记名字、告诉人结果——真正发生了什么，你只是旁边的人。"
        },
        {
          "speaker": "",
          "text": "停了一下。"
        },
        {
          "speaker": "猫小姐",
          "text": "但如果换护理，我就没法在宠物医院待了。"
        },
        {
          "speaker": "你",
          "text": "为什么。"
        },
        {
          "speaker": "猫小姐",
          "text": "我一摸猫就过敏。"
        },
        {
          "speaker": "",
          "text": "（……这个逻辑绕了一圈，又回到了起点。）"
        },
        {
          "speaker": "猫小姐",
          "text": "所以说——舍不得离猫太远。"
        },
        {
          "speaker": "",
          "text": "她笑了一声，把有爪印的杯盖翻过来留在桌上。"
        },
        {
          "speaker": "猫小姐",
          "text": "明天还开吗。"
        },
        {
          "speaker": "你",
          "text": "开。"
        },
        {
          "speaker": "猫小姐",
          "text": "好。"
        }
      ]
    },
    {
      "id": "dusk_intro",
      "type": "dialogue",
      "nodes": [
        {
          "speaker": "",
          "text": "天一暗，柚子把店里的灯开得更亮了——暖的，橙的。"
        },
        {
          "speaker": "柚子",
          "text": "柑橘碳酸备好了。黄昏开始卖。",
          "expr": "deadpan"
        }
      ]
